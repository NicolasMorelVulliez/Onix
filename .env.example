# Copiá este archivo a .env.local. Sin las variables de Firebase la app funciona solo en modo local.

# --- App (Firebase → Configuración del proyecto → Tus apps → Web) ---
VITE_FIREBASE_API_KEY=
# En producción usá el dominio de Hosting (tu-proyecto.web.app) para que el login funcione en el iPhone.
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=
# URL de las funciones en Vercel (vacío en desarrollo: las sirve Vite).
VITE_API_URL=

# --- Funciones (/api). En Vercel van en Settings → Environment Variables ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32+ caracteres al azar: openssl rand -base64 32
TOKEN_SECRET=
FIREBASE_PROJECT_ID=tu-proyecto
# Orígenes de la app separados por coma
APP_ORIGINS=https://tu-proyecto.web.app
